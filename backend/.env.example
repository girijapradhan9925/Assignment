# Server
PORT=3000
CORS_ORIGINS=*

# Product data source
FAKE_STORE_BASE_URL=https://fakestoreapi.com
CACHE_TTL_MS=60000
FEATURED_LIMIT=5
CATEGORY_TOP_RATED_LIMIT=3
UPSTREAM_TIMEOUT_MS=8000

# Email — default "console" needs no account (emails print to stdout)
# Switch to "smtp" for a local catcher (Mailpit/Mailhog) or real SMTP
EMAIL_PROVIDER=console
SALES_INBOX=sales@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=catalogue@localhost
